PORT=3001
HOST=127.0.0.1
APP_URL=http://localhost:5173
# Optional comma-separated legacy origins accepted during an endpoint migration.
ALLOWED_ORIGINS=
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters
# Google Cloud Console: OAuth client type Web application.
# Authorized redirect URI must match APP_URL + /auth/google/callback exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Or point at a downloaded Web OAuth client JSON (kept outside the repository).
GOOGLE_CREDENTIALS_FILE=
# Use https behind a reverse proxy in deployment.
TRUST_PROXY=0
COOKIE_SECURE=false
DATA_DIR=.data
