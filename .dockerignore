# A whitelist keeps OAuth secrets, live data and Android signing keys out of
# both the build context and image, including future files added to the repo.
**
!Dockerfile
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!capacitor.config.ts
!index.html
!src/
!src/**
!public/
!public/**
!server/
!server/**
!scripts/
!scripts/build-sw.mjs
**/.env
**/.env.*
**/.data/**
**/credentials.json
**/client_secret*.json
**/*-token.json
**/*.jks
**/*.keystore
**/*.pem
