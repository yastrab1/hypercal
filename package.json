{
  "name": "hypercal",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && (cd android && ./gradlew assembleDebug) && node scripts/package-android.mjs",
    "android:package": "node scripts/package-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "session-file-store": "^1.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yastrab1/hypercal.git"
  },
  "bugs": {
    "url": "https://github.com/yastrab1/hypercal/issues"
  },
  "homepage": "https://github.com/yastrab1/hypercal#readme"
}
